# Environments, Git & Caches
.venv/
venv/
__pycache__/
.pytest_cache/
.ruff_cache/
.git/

# Block dataset images/labels, but allow directory traversal & data.yaml
data/**/*
!data/**/
!data/**/*.yaml

# Block model weights & exported binaries across weights/, outputs/, and mlruns/
weights/
*.pt
*.pth
*.onnx
*.engine

# Block heavy image/plot artifacts (keep CSVs, YAMLs, JSONs, logs & mlflow.db readable)
outputs/**/*.jpg
outputs/**/*.jpeg
outputs/**/*.png
mlruns/**/*.jpg
mlruns/**/*.jpeg
mlruns/**/*.png